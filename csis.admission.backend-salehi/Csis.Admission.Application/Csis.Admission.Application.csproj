<Project Sdk="Microsoft.NET.Sdk">
			
	<PropertyGroup> 
		<Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
	</PropertyGroup>
							 
	<PropertyGroup Condition=" '$(Configuration)' != 'Debug' ">
		<DebugType>None</DebugType>
		<DebugSymbols>False</DebugSymbols>
	</PropertyGroup>
	
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Features\Courses\Validators\**" />
		<Compile Remove="Models\**" />
		<EmbeddedResource Remove="Features\Courses\Validators\**" />
		<EmbeddedResource Remove="Models\**" />
		<None Remove="Features\Courses\Validators\**" />
		<None Remove="Models\**" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Csis.Admission.UnitTests" />
		<InternalsVisibleTo Include="Csis.Admission.IntegrationTests" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Common\Commands\" />
		<Folder Include="Common\Queries\" />
		<Folder Include="Features\Pregnancies\Validators\" />
		<Folder Include="Features\ReligiousRoleQuestions\Dtos\" />
		<Folder Include="Features\ReligiousRoleQuestions\Queries\" />
		<Folder Include="Features\ShiaMinitories\" />
		<Folder Include="Features\StudentFriends\Validators\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Csis.Abstractions" Version="1.4.15" />
		<PackageReference Include="Csis.Authorization" Version="2.0.5" />
		<PackageReference Include="Csis.CompareImageAi" Version="1.0.2" />
		<PackageReference Include="Csis.Notification" Version="1.1.53" />
		<PackageReference Include="Csis.Paging" Version="1.6.0" />

		<PackageReference Include="AutoMapper" Version="15.1.0" />
		<PackageReference Include="Csis.Shared.Kernel.Public" Version="1.5.33" />
		<PackageReference Include="FluentAssertions" Version="8.6.0" />
		<PackageReference Include="Humanizer.Core" Version="2.14.1" />

		<PackageReference Include="MediatR" Version="13.1.0" />

		<PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />

		<PackageReference Include="Npoi.Mapper" Version="6.2.2" />

		<PackageReference Include="Serilog.Exceptions" Version="8.4.0" />

		<PackageReference Include="SixLabors.Fonts" Version="2.1.3" />

		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />

		<PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />

		<PackageReference Include="System.Drawing.Common" Version="9.0.9" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Csis.Admission.Domain\Csis.Admission.Domain.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Csis.FileManagement" Version="1.5.2" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Common\Messages.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Messages.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Common\Messages.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Messages.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.0" />
	</ItemGroup>

</Project>
